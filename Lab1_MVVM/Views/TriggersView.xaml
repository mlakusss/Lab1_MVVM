<UserControl x:Class="Lab1_MVVM.Views.TriggersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Lab1_MVVM.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <vm:TriggersViewModel/>
    </UserControl.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="{DynamicResource Triggers_Title}" FontWeight="Bold" FontSize="16"/>

            <GroupBox Header="{DynamicResource Triggers_Property}" Margin="0,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Triggers_Property_Hover}" Margin="0,0,0,5"/>
                    <Border Width="300" Height="60" Background="LightBlue" CornerRadius="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="LightBlue"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="Orange"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{DynamicResource Triggers_Property_Text}" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource Triggers_Data}" Margin="0,10">
                <StackPanel>
                    <CheckBox Content="{DynamicResource Triggers_Data_Checkbox}" 
                              IsChecked="{Binding IsHighlighted}" Margin="0,5"/>
                    <Border Width="300" Height="60" Background="LightGray" CornerRadius="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="LightGray"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter Property="Background" Value="Gold"/>
                                        <Setter Property="BorderBrush" Value="Red"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{DynamicResource Triggers_Data_Text}" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource Triggers_Event}" Margin="0,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Triggers_Event_Label}" Margin="0,0,0,5"/>
                    <Border Width="300" Height="60" Background="LightGreen" CornerRadius="5" Opacity="0">
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <TextBlock Text="{DynamicResource Triggers_Event_Text}" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </GroupBox>

            <TextBlock Text="{DynamicResource Triggers_Note}" 
                       FontSize="10" Foreground="Gray" Margin="0,10"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>