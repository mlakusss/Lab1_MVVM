<Window x:Class="Lab1_MVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Lab1_MVVM.Views"
        xmlns:vm="clr-namespace:Lab1_MVVM.ViewModels"
        Title="ЛР1 - MVVM привязки" Height="500" Width="800">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <TabControl>
        <TabItem Header="Привязка по умолчанию">
            <views:DefaultBindingView/>
        </TabItem>
        <TabItem Header="Двухсторонняя привязка">
            <views:TwoWayBindingView/>
        </TabItem>
    </TabControl>
</Window>